# Device simulator (reuses the api build stage artifacts)
FROM golang:1.24-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /out/ctc-sim ./simulator/ctc-sim

FROM alpine:3.20
RUN apk add --no-cache ca-certificates tzdata
WORKDIR /app
COPY --from=build /out/ctc-sim ./ctc-sim
ENTRYPOINT ["./ctc-sim"]
